{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cellulant Tingg Checkout Acknowledgement API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Acknowledgement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Acknowledge Payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tingg.africa/v3/checkout-api/acknowledgement/request",
            "headers": [
              {
                "name": "apikey",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send the final or partial delivered status for a checkout transaction back to the platform."
        }
      ]
    }
  ],
  "bundled": true
}