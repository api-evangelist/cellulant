      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 access token issuance for Tingg API calls.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fc7151aa-a9b1-4c40-83d8-d558a1afa18d",
          "name": "Request OAuth Access Token",
          "request": {
            "name": "Request OAuth Access Token",
            "description": {
              "content": "Exchange clientId, clientSecret, and apiKey for a bearer access token used to authorize subsequent Tingg API requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth",
                "token",
                "request"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e53b66df-535c-4e48-82ad-a08fbd950e54",
              "name": "Token issued",
              "originalRequest": {
